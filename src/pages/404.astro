---
import Base from '../layouts/Base.astro';

const css = `body{margin:0;background:#F7F4EF;color:#17130F;font-family:'Montserrat',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
main{min-height:100vh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:22px;max-width:760px;margin:0 auto;padding:40px 24px;box-sizing:border-box}
.wm{font:800 40px/1 'Fraunces',Georgia,serif;letter-spacing:-0.045em;color:#17130F;text-decoration:none}.wm span{color:#D4401F}
h1{margin:0;font:800 clamp(40px,8vw,72px)/1.02 'Montserrat',sans-serif;letter-spacing:-0.035em}
p{margin:0;font:500 19px/1.5 'Montserrat',sans-serif;color:#6A615A}
nav{display:flex;gap:12px;flex-wrap:wrap}
nav a{display:inline-flex;align-items:center;min-height:52px;padding:0 26px;border-radius:999px;font:600 16px/1 'Montserrat',sans-serif;text-decoration:none;color:#17130F;box-shadow:inset 0 0 0 1.5px #17130F}
nav a:first-child{background:#17130F;color:#fff;box-shadow:none}`;
---

<Base title="Страница не найдена — Kafka" noindex css={css}>
  <main>
    <a class="wm" href="/">kafka<span>.</span></a>
    <h1>Такой страницы нет</h1>
    <p>Возможно, ссылка устарела или в адресе опечатка. Вот куда можно перейти:</p>
    <nav aria-label="Разделы сайта">
      <a href="/">На главную</a>
      <a href="/products">Продукты</a>
      <a href="/integrations">Интеграции</a>
      <a href="/pricing">Тарифы</a>
    </nav>
  </main>
</Base>
