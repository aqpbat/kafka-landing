---
import Base from '../layouts/Base.astro';
import Artboard from '../components/Artboard.astro';
import { siteCss } from '../lib/dc/css';
import { PAGES, pageSchema, type PageMeta } from '../lib/seo';
import mainSrc from '../../design/project/Main.dc.html?raw';

export function getStaticPaths() {
  return PAGES.map((meta) => ({ params: { page: meta.path.slice(1) }, props: { meta } }));
}

const { meta } = Astro.props as { meta: PageMeta };

const sources = import.meta.glob<string>('../../design/project/*.dc.html', { query: '?raw', import: 'default', eager: true });
const logic = import.meta.glob<any>('../../design/project/*.dc.html', { query: '?dc-logic', import: 'default', eager: true });

const key = `../../design/project/${meta.file}.dc.html`;
const src = sources[key];
const css = siteCss(mainSrc, [{ src, scope: '.v-page' }]);
const faq = meta.faqSchema ? (new logic[key]({}).renderVals().faq as { q: string; a: string }[]) : undefined;
const schema = pageSchema(Astro.site!, meta, faq);
---

<Base title={meta.title} description={meta.description} keywords={meta.keywords} path={meta.path} schema={schema} css={css}>
  <Artboard name={meta.file} class="v-page" src={src} Component={logic[key]} />
</Base>

<script>
  import { mount } from '../lib/dc/runtime';

  const modules = import.meta.glob<any>('../../design/project/*.dc.html', { query: '?dc-logic', import: 'default' });
  const root = document.querySelector<HTMLElement>('[data-dc-root]')!;
  modules[`../../design/project/${root.dataset.dcRoot}.dc.html`]().then((Component) => mount(root, Component));
</script>
